{
 "description": "fast profile + streaming statement execution (--stream-exec: the python cell runs statement by statement while it decodes; semantics change on non-compiling cells, see CaPtain-Harness docs/harness.md). Eval only.",
 "driver": {
  "temperature": 0.7,
  "thinking_token_budget": 256,
  "max_output_tokens": 768,
  "max_images": 12,
  "image_drop_chunk": 6,
  "server_poll_s": 0.02,
  "server_grace_s": 0,
  "stream_exec": true,
  "keep_recent_tokens": 8000
 },
 "tool_backend_options": {
  "motion_speed_scale": 3,
  "default_max_speed_m_s": 0.1,
  "default_max_angular_speed_rad_s": 1.0,
  "concurrent_label_check": true
 },
 "backend_options": {
  "gripper_settle_min_steps": 6,
  "step_profile": {
   "speed_scale": 3,
   "slow_zone_m": 0.03,
   "settle_samples_needed": 1,
   "gripper_still_needed": 2
  }
 },
 "services": {
  "sam3_cache_images": 8,
  "molmo_stop_after_coords": true,
  "depth_resolution_level": 0
 }
}
