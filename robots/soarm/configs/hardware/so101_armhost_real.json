{
 "comment": "Real SO-101 on armhost for suite soarm_real (soarm/real_episode.py, soarm/real_driver.py). Calibration = the so101_armhost_*.json files next to this one ($SOARM_CODE is set by env.sh; roll zero 1915 since 2026-11-13); recalibrate for your own arm and cameras. Cameras come from tools/camstream.py (armcal), undistorted, cropped to a square and resized to image_size.",
 "robot": "so101-armhost",
 "port": "/dev/ttyACM0",
 "calibration": {
  "joint_map": "$SOARM_CODE/configs/hardware/so101_armhost_joint_map.json",
