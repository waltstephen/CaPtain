# Copy to robots/soarm/soarm.env (git-ignored) or ~/.soarm.env and edit. Values shown are the defaults.
# Variable NAMES only for secrets: the API keys live in the separate files below (chmod 600), never here or in git.

# Work dir: venvs, OSMesa, Menagerie, runs, logs, exported data (~10-15 GB plus ~5-30 MB per finished episode)
SOARM_ROOT=$HOME/soarm_work
# Seed-range owner (CONTRACT.md 1, soarm.taskspec.SEED_RANGES): armhost | datahost. No default: batch.py --machine
# refuses seeds outside that machine's range.
SOARM_MACHINE=datahost
# Harness checkout (the git submodule of this repo) and the SFT code
#HARNESS_DIR=<repo>/harness
#SFT_DIR=<repo>/sft
# Menagerie robotstudio_so101 (fetch_assets.sh puts it here)
#SOARM_MENAGERIE=$SOARM_ROOT/menagerie/robotstudio_so101
#RUNS_DIR=$SOARM_ROOT/runs
#LOG_DIR=$SOARM_ROOT/logs
#DATA_DIR=$SOARM_ROOT/data
# Python environments (ROLLOUT.md section 2)
#SOARM_VENV=$SOARM_ROOT/venv-srv                      # env server + driver + tools (Python 3.11, mujoco 3.3.7)
#STUDENT_PYTHON=$SOARM_ROOT/student/bin/python        # the agent's sandboxed Python 3.11 (numpy 1.26.4, scipy 1.13.1, Pillow 10.4.0)
#SFT_VENV=$SOARM_ROOT/venv-sft                        # only for build_sft.sh / train_sft.sh
#VLLM_VENV=$SOARM_ROOT/venv-vllm                      # only for serving student checkpoints
#FRESH_ENV_PREFLIGHT_PATH=$SOARM_ROOT/preflight.json  # written by rl/toolchain_preflight.py
# Rendering: osmesa (CPU, needs conda-forge mesalib<25 in MESA_DIR) or egl (GPU / a system EGL with PLATFORM_DEVICE)
#SOARM_GL=osmesa
#MESA_DIR=$SOARM_ROOT/mesa
# Teacher credentials (files with KEY=value lines, chmod 600):
#   GATEWAY_ENV_FILE  must define TEACHER_BASE_URL (…/v1) and TEACHER_API_KEY  (OpenAI Responses API gateway);
#                     OPENAI_BASE_URL / OPENAI_API_KEY are accepted as aliases
#   DEEPSEEK_ENV_FILE must define DEEPSEEK_API_KEY and optionally DEEPSEEK_BASE_URL     (official DeepSeek API)
#GATEWAY_ENV_FILE=$HOME/.soarm_gateway.env
#DEEPSEEK_ENV_FILE=$HOME/.soarm_deepseek.env
# Data learning (ROLLOUT.md 4.1): the Responses teacher writes its working out in a visible log_reasoning_step call,
# which the proxy folds into reasoning_content -> the <think> block of the SFT rows. forced = 2 calls/request,
# parallel = 1 (the teacher may skip thinking). Needs a Responses gateway; the official DeepSeek API already returns
# its reasoning, so it refuses --provider deepseek.
#SOARM_DATA_LEARNING=off                 # off | forced | parallel
#SOARM_DATA_LEARNING_ROUNDS=3            # scratchpad calls per request before the tool is withdrawn
#SOARM_RESPONSE_IMAGE_CAP=               # send only the N most recent history images (empty = all)
#SOARM_NO_SANDBOX=0                      # 1 = run episodes without bwrap (host forbids unprivileged user namespaces; ROLLOUT §0)
# Perception (ROLLOUT §3.1): real SAM3 + Molmo2-8B services (LIBERO paper protocol); privileged = tests only
#SOARM_PERCEPTION=real                   # real | privileged
#SOARM_SAM3_URLS=http://127.0.0.1:8114   # comma-separated replicas, one per episode (default SAM3_URL / :8114)
#SOARM_MOLMO_URLS=http://127.0.0.1:8122/v1
#SOARM_DEPTH=moge2                       # moge2 (MoGe-2 from RGB, real-arm mono_depth path) | sensor (tests/ablation only)
#SOARM_DEPTH_URLS=http://127.0.0.1:8130  # MoGe-2 depth_server.py replicas, one per episode (default CAPTAIN_DEPTH_URL / :8130)
#SOARM_DEPTH_NOISE=off                   # sensor depth only: off | sigma in metres at 1 m (z^2-scaled sensor noise)
# Tokenizer/model dir for build_sft.sh (any CaPtain-4B / Qwen3.5-4B checkpoint dir)
#TOKENIZER_MODEL=/path/to/CaPtain-4B
